# Upstash Redis, set by `vercel integration add upstash` and pulled with
# `vercel env pull .env.local`. Required in production; without them,
# development keeps cities in memory.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional. "memory" keeps cities in memory in production too: only for a
# single long-running server, never for serverless.
CITY_STORE=
